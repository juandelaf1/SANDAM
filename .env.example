# SANDAM - Environment Variables

# Database - Local PostgreSQL
# Ejemplo: postgresql+asyncpg://postgres:TU_PASSWORD@localhost:5432/sandam
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/sandam

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*