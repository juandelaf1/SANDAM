# SANDAM - Environment Variables
# Copia este archivo a .env y ajusta los valores.

# Database - Local PostgreSQL
# Ejemplo: postgresql+asyncpg://postgres:TU_PASSWORD@localhost:5432/sandam
# Para tests con SQLite: sqlite+aiosqlite:///:memory:
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/sandam

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# CORS (lista separada por comas; "*" solo para desarrollo)
CORS_ORIGINS=*

# API Keys for external services (opcionales)
AEMET_API_KEY=
SOCIB_API_KEY=
